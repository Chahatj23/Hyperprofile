# From Meta App Dashboard > Instagram > API setup with Instagram login.
# NOTE: these are the *Instagram* app id/secret, not Settings > Basic.
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://YOUR-TUNNEL.example.com/auth/instagram/callback
IG_WEBHOOK_VERIFY_TOKEN=change-me-long-random
# Graph API version. Check the dashboard for the current one before launch.
IG_API_VERSION=v26.0
PUBLIC_URL=https://YOUR-TUNNEL.example.com
# 32 bytes hex (64 chars): openssl rand -hex 32
TOKEN_ENC_KEY=
STATE_SECRET=change-me-another-long-random
PORT=3000
